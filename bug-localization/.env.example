# Not needed for the default local Ollama backend — it requires no key.
# Only fill this in if you switch provider to "anthropic" in config.yaml.
# ANTHROPIC_API_KEY=sk-ant-...

# Only fill in if you switch provider to "groq" in config.yaml.
# Comma-separated list — the app automatically rotates to the next key when the
# current one hits its rate/day limit (HTTP 429), instead of failing the run.
# GROQ_API_KEYS=gsk_first_key,gsk_second_key
